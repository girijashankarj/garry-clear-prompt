# ============================================================
# Garry Clear Prompt — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All VITE_ prefixed variables are exposed to the browser.
# Do NOT put secrets that should stay server-side here.
# ============================================================

# --- App -----------------------------------------------------------

# Log level for the structured logger.
# Values: debug | info | warn | error
# Default: "debug" in development, "info" in production.
VITE_LOG_LEVEL=

# --- LLM Integration (Coming Soon) --------------------------------
# These variables are used when the LLM runner feature is enabled.
# Currently disabled — safe to leave blank.

# Enable the LLM runner feature (true/false).
# Default: false
VITE_LLM_FEATURE_ENABLED=false

# OpenAI
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
VITE_ANTHROPIC_API_KEY=

# AWS Bedrock
VITE_AWS_ACCESS_KEY_ID=
VITE_AWS_SECRET_ACCESS_KEY=
VITE_AWS_REGION=us-east-1

# --- Build ---------------------------------------------------------

# Node environment (set automatically by Vite).
# Values: development | production | test
# NODE_ENV=development
