# ============================================================
# Garry Clear Prompt — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All VITE_ prefixed variables are exposed to the browser.
# Do NOT put secrets that should stay server-side here.
# ============================================================

# --- App -----------------------------------------------------------

# Log level for the structured logger.
# Values: debug | info | warn | error
# Default: "debug" in development, "info" in production.
VITE_LOG_LEVEL=

# --- Local ML intent (optional, in-browser) ------------------------
# When true, Before / After shows a button to re-classify the domain checklist
# using Transformers.js + a quantized DistilBERT model (downloads on first use).
# Prompt text stays in the browser; no Hugging Face API key required.
# Default: false
VITE_ML_INTENT_ENABLED=false

# --- LLM Integration (Coming Soon) --------------------------------
# These variables are used when the LLM runner feature is enabled.
# Currently disabled — safe to leave blank.
#
# SECURITY: Never put real API keys in VITE_* variables — they are
# shipped to the browser and visible to anyone. For production LLM
# calls, use a backend proxy that reads keys from server-side env only.

# Enable the LLM runner feature (true/false).
# Default: false
VITE_LLM_FEATURE_ENABLED=false

# OpenAI (use placeholders only; real keys only in backend proxy)
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (use placeholders only; real keys only in backend proxy)
VITE_ANTHROPIC_API_KEY=

# AWS Bedrock (use placeholders only; real keys only in backend proxy)
VITE_AWS_ACCESS_KEY_ID=
VITE_AWS_SECRET_ACCESS_KEY=
VITE_AWS_REGION=us-east-1

# --- Build ---------------------------------------------------------

# Node environment (set automatically by Vite).
# Values: development | production | test
# NODE_ENV=development
